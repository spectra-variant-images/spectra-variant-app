{% comment %}
  Spectra Variant Images - Data Injection Template
  Injects variant media mapping data for JavaScript filtering
{% endcomment %}

<script id="SpectraVariantMediaMap" type="application/json">
  {
    {% for variant in product.variants %}
      "{{ variant.id }}": [
        {% comment %} Get assigned media from metafield {% endcomment %}
        {% if variant.metafields.spectra.variant_media %}
          {{ variant.metafields.spectra.variant_media }}
        {% elsif variant.metafields.spectra.swatch %}
          {% comment %} Fallback to empty array if no assignment {% endcomment %}
        {% else %}
          {% comment %} Try to get from product-level mapping {% endcomment %}
          {% assign variant_index = forloop.index0 %}
          {% if product.metafields.spectra.variant_media %}
            {{ product.metafields.spectra.variant_media[variant_index] }}
          {% endif %}
        {% endif %}
      ]{% unless forloop.last %},{% endunless %}
    {% endfor %}
  }
</script>

<script id="SpectraGlobalMedia" type="application/json">
  {% if product.metafields.spectra.global_media %}
    {{ product.metafields.spectra.global_media }}
  {% else %}
    []
  {% endif %}
</script>

{% comment %}
  Load the filtering script
  In production, this would be loaded from the app's CDN
{% endcomment %}
<script src="{{ 'spectra-filter.js' | asset_url }}" defer></script>
